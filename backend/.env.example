# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Port to bind (Render automatically provides $PORT)
PORT=8000

# Secret key used for signing JWT access tokens (Change this in production!)
JWT_SECRET=face-recognition-enterprise-secret-key-change-in-production

# Comma-separated list of allowed CORS origins
# (Localhost and https://*.onrender.com are allowed automatically)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database URL:
# - Leave blank to use local SQLite (access_control.db)
# - Or provide PostgreSQL connection string for production:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
